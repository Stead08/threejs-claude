{
  "name": "threejs-claude",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:cf": "bash scripts/workers-build.sh",
    "preview": "pnpm --filter web preview",
    "deploy": "pnpm build && pnpm --filter web deploy",
    "build:wasm": "wasm-pack build crates/wasm --target web --release --out-dir ../../packages/engine/wasm-pkg --out-name rhythm_wasm",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "test": "vitest run",
    "test:e2e": "pnpm --filter web test:e2e",
    "depcruise": "depcruise apps packages games",
    "gen:assets": "cargo run -p tools --bin gen_midi -- --out charts/metronome.mid && cargo run -p tools --bin gen_sf2 -- --out charts/dev.sf2"
  },
  "devDependencies": {
    "binaryen": "^131.0.0",
    "dependency-cruiser": "^18.1.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
